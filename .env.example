# Plantilla del archivo .env — copiala al servidor y completá los valores.
#
#   cp .env.example .env    (y despues editá .env)
#
# El .env real NUNCA se sube al repo: está en .gitignore porque acá van las
# claves. Este archivo de ejemplo sí se sube, pero no lleva ningún valor real.
#
# En tu computadora no hace falta ninguno de los dos: `npm run dev` arranca en
# modo desarrollo y anda sin .env.

PORT=3000

# OBLIGATORIA. Sin ella el servidor no arranca en producción, a propósito: con
# este secreto se firman las sesiones, y si fuera uno de ejemplo cualquiera
# podría fabricarse una sesión de administrador. Generala con:
#
#   openssl rand -hex 32
#
JWT_SECRET=

# Contraseña del usuario admin. OJO: solo se aplica la primera vez que se crea
# data/chat.db. Si ya arrancaste el servidor sin ella, quedó en "admin123" —
# que es pública — y hay que cambiarla desde la app o borrando la base.
ADMIN_PASSWORD=

# PONELA EN 1 SI HAY NGINX DELANTE (es el caso del manual de DEPLOY.md).
# Sin esto, todas las peticiones le llegan a Node desde 127.0.0.1 y los límites
# por IP verían una sola conexión: el primer abusivo dejaría afuera al resto.
# No viene encendida de fábrica porque hacerlo sería peor — un servidor SIN
# proxy delante creería la cabecera X-Forwarded-For que le mande cualquiera, y
# los límites se saltarían con una IP inventada por intento.
# El arranque imprime qué modo está activo; miralo en `pm2 logs`.
TRUST_PROXY=1

# --- Opcionales: estos son los valores por defecto ---

# Mensajes que se conservan por sala. Los más viejos se borran solos.
ROOM_HISTORY_LIMIT=500

# Vida de un mensaje privado, en días. 0 = sin vencimiento (vigilá el tamaño de
# data/chat.db si lo desactivás).
DM_RETENTION_DAYS=90

# Máximo de mensajes privados guardados por conversación.
DM_PAIR_LIMIT=500

# Vida de una foto en disco, en minutos (1440 = 24 h). 0 = sin vencimiento por
# tiempo; igual desaparecen cuando su mensaje sale del historial.
PHOTO_TTL_MINUTES=1440

# Techo de la carpeta uploads/. Al llegar, se rechazan las subidas nuevas con un
# mensaje claro y el chat sigue funcionando. 0 = sin techo (no recomendado: un
# disco lleno frena a SQLite y ahí se cae todo).
PHOTO_DISK_LIMIT_MB=500
